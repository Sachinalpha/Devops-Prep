# awk '{print $1}' → print first field (IP address in nginx log format)
# sort             → sort alphabetically (required before uniq)
# uniq -c          → count consecutive duplicates, prepend count
# sort -rn         → sort numerically (-n) in reverse (-r) = highest first
# head -$TOP_N     → show only first 10 lines

echo ""
echo "--- Top $TOP_N Requested URLs ---"
awk '{print $7}' "$LOG_FILE" | sort | uniq -c | sort -rn | head -$TOP_N
# $7 → 7th field = URL/path in nginx log format
# Nginx default log format: IP - - [date] "METHOD URL PROTOCOL" status bytes

echo ""
echo "--- HTTP Status Code Distribution ---"
awk '{print $9}' "$LOG_FILE" | sort | uniq -c | sort -rn
# $9 → HTTP status code field

echo ""
echo "--- Top $TOP_N Slowest Requests (if response time logged) ---"
awk '{print $NF, $7}' "$LOG_FILE" | sort -rn | head -$TOP_N
# $NF → last field (response time if nginx logs it with $request_time)

echo ""
echo "--- Requests per Hour ---"
awk '{print $4}' "$LOG_FILE" | cut -d: -f2 | sort | uniq -c
# $4 → timestamp field like [15/Jan/2024:10:30:45]
# cut -d: -f2 → extract hour (split by :, take 2nd field)

echo ""
echo "--- 4xx and 5xx Error Requests ---"
awk '$9 ~ /^[45]/' "$LOG_FILE" | awk '{print $9, $7, $1}' | sort | uniq -c | sort -rn | head -$TOP_N
# $9 ~ /^[45]/ → filter rows where status code starts with 4 or 5
# ~ → regex match operator in awk


