  #                    Perfect for backups — you don't need to edit files
  # || → OR: if clone fails (repo exists), run remote update instead
  # git remote update → fetch all branches from all remotes
done

# ─── COMPRESS THE WHOLE BACKUP ────────────────────────────────────────────────
cd "$BACKUP_DIR"
tar -czf "github_backup_${DATE}.tar.gz" "$DATE/"
rm -rf "$DATE/"
