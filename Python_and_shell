#!/bin/bash
# disk_alert.sh
# Purpose: Monitor disk usage and alert via Slack webhook when threshold breached
# Real production pattern used at scale

SLACK_WEBHOOK="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
THRESHOLD=85     # Alert at 85% disk usage
HOSTNAME=$(hostname)  # Get the machine's hostname for alert context

# ─── CHECK EACH MOUNTED PARTITION ─────────────────────────────────────────────
df -H | grep -vE "^Filesystem|tmpfs|udev" | while read LINE; do
  # df -H → use powers of 1000 (vs -h which uses 1024)
  USAGE=$(echo "$LINE" | awk '{print $5}' | tr -d '%')
  # tr -d '%' → delete the percent sign character (-d = delete)
  MOUNT=$(echo "$LINE" | awk '{print $6}')
  # $6 → 6th column = mount point

  if [ "$USAGE" -gt "$THRESHOLD" ]; then
    # Build Slack message payload in JSON format
    PAYLOAD="{
      \"text\": \"🚨 *DISK ALERT* on \`${HOSTNAME}\`\",
      \"attachments\": [{
        \"color\": \"danger\",
        \"fields\": [{
          \"title\": \"Partition\",
          \"value\": \"$MOUNT\",
          \"short\": true
        },{
          \"title\": \"Usage\",
          \"value\": \"${USAGE}%\",
          \"short\": true
        }]
      }]
    }"
    # JSON with nested object and array — note escaped quotes with \"

    # Send to Slack using curl
    curl -s -X POST -H 'Content-type: application/json' \
      --data "$PAYLOAD" "$SLACK_WEBHOOK"
    # -s         → silent mode (no progress meter)
    # -X POST    → use HTTP POST method
    # -H         → set HTTP header
    # --data     → send this data as request body
  fi
done


