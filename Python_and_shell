KUBECONFIG="${HOME}/.kube/config"  # Path to kubectl config

# ─── CHECK IF kubectl IS AVAILABLE ────────────────────────────────────────────
if ! command -v kubectl &>/dev/null; then
  echo "ERROR: kubectl not found in PATH"
  exit 1
fi
# command -v → check if command exists (preferred over `which`)
# &>/dev/null → discard both stdout and stderr

echo "Monitoring pods in namespace: $NAMESPACE"
echo "Threshold: $RESTART_THRESHOLD restarts"
echo "----------------------------------------"

# ─── GET ALL PODS AND THEIR RESTART COUNTS ────────────────────────────────────
kubectl get pods -n "$NAMESPACE" --no-headers | while read POD_LINE; do
  # --no-headers → skip the column header row
  POD_NAME=$(echo "$POD_LINE" | awk '{print $1}')
  STATUS=$(echo "$POD_LINE" | awk '{print $3}')
  RESTARTS=$(echo "$POD_LINE" | awk '{print $4}')
  # kubectl output columns: NAME | READY | STATUS | RESTARTS | AGE

  if [ "$RESTARTS" -gt "$RESTART_THRESHOLD" ] 2>/dev/null; then
    # 2>/dev/null → suppress error if RESTARTS is not a number
    echo "⚠️  HIGH RESTARTS: Pod=$POD_NAME Status=$STATUS Restarts=$RESTARTS"
    echo "   Recent logs:"
    kubectl logs "$POD_NAME" -n "$NAMESPACE" --tail=10 2>/dev/null
    # --tail=10 → only show last 10 lines of logs
    echo "---"
  fi

  # ─── FLAG CRASHLOOPBACKOFF ────────────────────────────────────────────────
  if [[ "$STATUS" == *"CrashLoop"* ]]; then
    echo "🔴 CRASHLOOP: $POD_NAME is in $STATUS"
    kubectl describe pod "$POD_NAME" -n "$NAMESPACE" | grep -A5 "Last State:"
    # grep -A5 → show 5 lines AFTER the matching line (context)
  fi
done


