#!/bin/bash
# cpu_killer.sh
# Purpose: Find and optionally kill processes consuming excessive CPU
# Used in production to prevent single runaway processes from starving others

CPU_THRESHOLD=90    # Kill processes using more than 90% CPU
WHITELIST=("mysql" "java" "node")  # Never kill these processes
DRY_RUN="${1:-true}"  # Pass "false" as argument to actually kill

echo "=== CPU Hog Monitor: $(date) ==="

ps aux --sort=-%cpu | awk 'NR>1 && $3>'"$CPU_THRESHOLD"'' | while read LINE; do
  # ps aux         → list all processes with resource usage
  # --sort=-%cpu   → sort by CPU descending (- = descending)
  # awk 'NR>1 &&   → skip header line AND
  #     $3>90'     → only show rows where CPU column ($3) > 90

  PID=$(echo "$LINE" | awk '{print $2}')
  CPU=$(echo "$LINE" | awk '{print $3}')
  PROC=$(echo "$LINE" | awk '{print $11}')
  # $11 → command name column in ps aux output

  # ─── CHECK WHITELIST ──────────────────────────────────────────────────────
  SKIP=false
  for SAFE_PROC in "${WHITELIST[@]}"; do
    if [[ "$PROC" == *"$SAFE_PROC"* ]]; then
      # [[ == *pattern* ]] → wildcard/glob matching in [[ ]]
      SKIP=true
      break  # Exit the for loop early
    fi
  done

  if [ "$SKIP" = true ]; then
    echo "SKIPPED (whitelisted): PID=$PID CPU=${CPU}% CMD=$PROC"
    continue  # Skip to next iteration of while loop
  fi

  echo "HIGH CPU: PID=$PID CPU=${CPU}% CMD=$PROC"

  if [ "$DRY_RUN" = "false" ]; then
    kill -15 "$PID"
    # kill -15 → send SIGTERM (graceful termination request)
    # Use -9 (SIGKILL) only if -15 doesn't work — SIGKILL cannot be caught
    echo "Sent SIGTERM to PID $PID"
  else
    echo "(DRY RUN) Would kill PID $PID"
  fi
done


