#!/bin/bash
# health_check.sh
# Purpose: Check system health - CPU, memory, disk usage, services
# Commonly used in production to alert DevOps teams

# ─── CONFIGURATION ───────────────────────────────────────────────────────────
THRESHOLD_CPU=80          # Alert if CPU usage exceeds 80%
THRESHOLD_MEM=80          # Alert if memory usage exceeds 80%
THRESHOLD_DISK=90         # Alert if disk usage exceeds 90%
LOG_FILE="/var/log/health_check.log"   # Where to save logs
EMAIL="devops@company.com"             # Alert email address

# ─── TIMESTAMP ────────────────────────────────────────────────────────────────
DATE=$(date '+%Y-%m-%d %H:%M:%S')
# date '+%Y-%m-%d %H:%M:%S' → formats the current date/time as "2024-01-15 10:30:00"
# $(...) → command substitution: runs command and puts output into variable

# ─── CPU CHECK ────────────────────────────────────────────────────────────────
CPU_USAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1)
# top -bn1   → run top in batch mode (-b), 1 iteration (-n1), non-interactive
# grep "Cpu(s)" → filter the CPU line
# awk '{print $2}' → print the 2nd field (the CPU usage percentage)
# cut -d'%' -f1   → remove the % sign, keep only the number

# Integer comparison using bc (basic calculator for floating point)
if (( $(echo "$CPU_USAGE > $THRESHOLD_CPU" | bc -l) )); then
  echo "[$DATE] ALERT: CPU usage is ${CPU_USAGE}% (threshold: ${THRESHOLD_CPU}%)" | tee -a $LOG_FILE
  # tee -a → write to stdout AND append to log file simultaneously
fi

# ─── MEMORY CHECK ─────────────────────────────────────────────────────────────
MEM_TOTAL=$(free | grep Mem | awk '{print $2}')
# free      → shows memory stats
# grep Mem  → filter the row labelled "Mem"
# awk '{print $2}' → get the "Total" column

MEM_USED=$(free | grep Mem | awk '{print $3}')
# awk '{print $3}' → get the "Used" column

MEM_USAGE=$(( MEM_USED * 100 / MEM_TOTAL ))
# $((...)) → arithmetic expression: compute percentage

if [ "$MEM_USAGE" -gt "$THRESHOLD_MEM" ]; then
  echo "[$DATE] ALERT: Memory usage is ${MEM_USAGE}%" | tee -a $LOG_FILE
fi
# -gt → "greater than" numeric comparison in [ ] test

# ─── DISK CHECK ───────────────────────────────────────────────────────────────
df -h | grep -vE '^Filesystem|tmpfs|cdrom' | awk '{print $5 " " $6}' | while read OUTPUT; do
  # df -h         → disk usage in human-readable format
  # grep -vE      → exclude lines matching this regex pattern (-v = invert, -E = extended regex)
  # awk '{print $5 " " $6}' → print the "Use%" and "Mounted on" columns
  # while read OUTPUT → read each line one at a time
  USAGE=$(echo $OUTPUT | awk '{print $1}' | cut -d'%' -f1)
  PARTITION=$(echo $OUTPUT | awk '{print $2}')
  if [ "$USAGE" -gt "$THRESHOLD_DISK" ]; then
    echo "[$DATE] ALERT: Partition $PARTITION is at ${USAGE}% disk usage" | tee -a $LOG_FILE
  fi
done

# ─── SERVICE CHECK ────────────────────────────────────────────────────────────
SERVICES=("nginx" "mysql" "redis")
# Array declaration in bash

for SERVICE in "${SERVICES[@]}"; do
  # "${SERVICES[@]}" → expands all array elements
  if ! systemctl is-active --quiet "$SERVICE"; then
    # systemctl is-active → checks if service is running
    # ! → negate the condition (true if service is NOT active)
    # --quiet → suppress output, only set exit code
    echo "[$DATE] CRITICAL: $SERVICE is NOT running!" | tee -a $LOG_FILE
    # Uncomment to auto-restart: systemctl restart "$SERVICE"
  fi
done

echo "[$DATE] Health check complete." | tee -a $LOG_FILE


