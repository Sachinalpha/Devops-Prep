#!/bin/bash
# service_watchdog.sh
# Purpose: Monitor a service, restart it if down, alert on repeated failures
# A poor-man's systemd watchdog — used when systemd not available (containers)

SERVICE="nginx"
MAX_RESTARTS=3        # After 3 restarts, send critical alert and stop trying
RESTART_COUNT=0
CHECK_INTERVAL=30     # Check every 30 seconds
ALERT_EMAIL="oncall@company.com"

send_alert() {
  local SUBJECT="$1"   # local → variable is local to this function only
  local BODY="$2"
  echo "$BODY" | mail -s "$SUBJECT" "$ALERT_EMAIL"
  # mail -s → send email with subject
  # Requires mailutils or sendmail configured on system
}

while true; do
  # while true → infinite loop (watchdog runs forever)
  if ! systemctl is-active --quiet "$SERVICE"; then
    RESTART_COUNT=$((RESTART_COUNT + 1))
    # $((...)) → arithmetic expansion

    echo "[$(date)] $SERVICE is down. Restart attempt #$RESTART_COUNT"

    if [ "$RESTART_COUNT" -le "$MAX_RESTARTS" ]; then
      systemctl restart "$SERVICE"
      sleep 5  # Give service time to start

      if systemctl is-active --quiet "$SERVICE"; then
        echo "[$(date)] $SERVICE restarted successfully."
        send_alert "[$SERVICE] Restarted on $(hostname)" \
          "$SERVICE went down and was restarted. Count: $RESTART_COUNT"
        RESTART_COUNT=0  # Reset counter on successful restart
      fi
    else
      # Service is down and we've exceeded restart limit
      send_alert "CRITICAL: [$SERVICE] REPEATED FAILURES on $(hostname)" \
        "$SERVICE has failed $RESTART_COUNT times and is not recovering. Manual intervention required."
      echo "[$(date)] CRITICAL: Exceeded max restarts. Stopping watchdog."
      exit 1
    fi
  else
    RESTART_COUNT=0   # Service is up, reset counter
  fi

  sleep "$CHECK_INTERVAL"
done


