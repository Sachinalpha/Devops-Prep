  "https://api.github.com/orgs/$GITHUB_ORG/repos?per_page=100&type=all" \
  | python3 -c "import sys,json; [print(r['ssh_url']) for r in json.load(sys.stdin)]")
# curl -s → silent (no progress bar)
# -H "Authorization: token ..." → send auth header for private repos
# python3 -c → inline Python to parse JSON and extract SSH clone URLs
# per_page=100 → get up to 100 repos per page

