#!/usr/bin/env python3
"""
ec2_manager.py
Purpose: List, start, stop, tag EC2 instances using boto3 (AWS SDK for Python)
Critical skill for any DevOps engineer working with AWS
"""

import boto3                    # AWS SDK for Python
import argparse                 # Command-line argument parsing
from botocore.exceptions import ClientError  # AWS-specific exceptions
import json
from typing import List, Dict  # Type hints for better code documentation

def get_ec2_client(region: str = 'us-east-1'):
    """Create and return an EC2 client for the specified region"""
    return boto3.client('ec2', region_name=region)
    # boto3.client() → low-level service client
    # Credentials auto-loaded from: env vars, ~/.aws/credentials, IAM role

def list_instances(client, filters: List[Dict] = None) -> List[Dict]:
    """
    List all EC2 instances with optional filters.
    filters example: [{'Name': 'instance-state-name', 'Values': ['running']}]
    """
    kwargs = {}
    if filters:
        kwargs['Filters'] = filters
    # **kwargs unpacking — only add Filters key if filters provided

    try:
        response = client.describe_instances(**kwargs)
        # **kwargs → unpack dictionary as keyword arguments
        instances = []
        for reservation in response['Reservations']:
            # EC2 returns instances grouped in Reservations
            for instance in reservation['Instances']:
                # Extract useful fields into a cleaner dict
                name = next(
                    (tag['Value'] for tag in instance.get('Tags', [])
                     if tag['Key'] == 'Name'),
                    'unnamed'
                )
                # next(generator, default) → get first matching tag or 'unnamed'
                # generator expression: (x for x in iterable if condition)

                instances.append({
                    'id': instance['InstanceId'],
                    'type': instance['InstanceType'],
                    'state': instance['State']['Name'],
                    'name': name,
                    'ip': instance.get('PublicIpAddress', 'N/A'),
                    # .get('key', default) → returns default if key not present
                    'launch_time': str(instance['LaunchTime'])
                })
        return instances
    except ClientError as e:
        print(f"AWS Error: {e.response['Error']['Message']}")
        return []

def start_instances(client, instance_ids: List[str]) -> bool:
    """Start stopped EC2 instances"""
    try:
        response = client.start_instances(InstanceIds=instance_ids)
        starting = [i['InstanceId'] for i in response['StartingInstances']]
        # List comprehension: [expression for item in iterable]
        print(f"Starting instances: {starting}")
        return True
    except ClientError as e:
        print(f"Error starting instances: {e}")
        return False

def stop_instances(client, instance_ids: List[str], force: bool = False) -> bool:
    """Stop running EC2 instances"""
    try:
        response = client.stop_instances(
            InstanceIds=instance_ids,
            Force=force  # True = force stop (like pulling power)
        )
        stopping = [i['InstanceId'] for i in response['StoppingInstances']]
        print(f"Stopping instances: {stopping}")
        return True
    except ClientError as e:
        print(f"Error stopping instances: {e}")
        return False

def tag_instances(client, instance_ids: List[str], tags: Dict[str, str]) -> bool:
    """Apply tags to EC2 instances — crucial for cost allocation & tracking"""
    tag_list = [{'Key': k, 'Value': v} for k, v in tags.items()]
    # Dict comprehension into list: convert {k:v} dict to [{'Key':k,'Value':v}] list
    try:
        client.create_tags(Resources=instance_ids, Tags=tag_list)
        print(f"Tagged {len(instance_ids)} instances")
        return True
    except ClientError as e:
        print(f"Error tagging: {e}")
        return False

def find_untagged_instances(client) -> List[str]:
    """Find instances missing required tags — compliance checking"""
    REQUIRED_TAGS = {'Environment', 'Owner', 'CostCenter'}
    # Python set — unordered collection of unique values
    all_instances = list_instances(client)
    untagged = []
    for inst in all_instances:
        # We'd need the raw tags here; simplified for illustration
        if inst['name'] == 'unnamed':
            untagged.append(inst['id'])
    return untagged

def main():
    parser = argparse.ArgumentParser(description='EC2 Instance Manager')
    parser.add_argument('action', choices=['list', 'start', 'stop', 'tag', 'audit'])
    # choices → only allow these specific values
    parser.add_argument('--region', default='us-east-1')
    parser.add_argument('--ids', nargs='+', help='Instance IDs')
    # nargs='+' → accept one or more values as a list
    parser.add_argument('--state', choices=['running', 'stopped', 'all'], default='all')
    args = parser.parse_args()

    client = get_ec2_client(args.region)

    if args.action == 'list':
        filters = None
        if args.state != 'all':
            filters = [{'Name': 'instance-state-name', 'Values': [args.state]}]
        instances = list_instances(client, filters)
        print(json.dumps(instances, indent=2, default=str))
        # indent=2 → pretty-print with 2-space indentation
        # default=str → convert non-serializable objects (like datetime) to strings

    elif args.action == 'start' and args.ids:
        start_instances(client, args.ids)

    elif args.action == 'stop' and args.ids:
        stop_instances(client, args.ids)

    elif args.action == 'audit':
        untagged = find_untagged_instances(client)
        print(f"Untagged instances: {untagged}")

if __name__ == '__main__':
    main()


