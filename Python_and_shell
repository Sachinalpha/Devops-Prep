import requests, subprocess, time, json

class DeploymentValidator:
    """Validate a deployment is healthy across all system layers"""

    def __init__(self, base_url: str):
        self.base_url = base_url
        self.checks = []

    def add_result(self, name: str, passed: bool, details: str = ''):
        self.checks.append({'name': name, 'passed': passed, 'details': details})

    def check_http_health(self):
        """Layer 1: Is the application responding?"""
        try:
            r = requests.get(f"{self.base_url}/health", timeout=10)
            data = r.json()
            self.add_result('HTTP Health', r.status_code == 200 and data.get('status') == 'ok',
                           f"Status: {r.status_code}, Response: {data}")
        except Exception as e:
            self.add_result('HTTP Health', False, str(e))

    def check_database_connectivity(self):
        """Layer 2: Can the app reach the database?"""
        try:
            r = requests.get(f"{self.base_url}/health/db", timeout=15)
            self.add_result('DB Connectivity', r.status_code == 200)
        except Exception as e:
            self.add_result('DB Connectivity', False, str(e))

    def check_response_time(self, max_ms: int = 500):
        """Layer 3: Is performance acceptable?"""
        import time
        start = time.perf_counter()
        try:
            requests.get(f"{self.base_url}/api/v1/ping", timeout=10)
            elapsed_ms = (time.perf_counter() - start) * 1000
            self.add_result('Response Time', elapsed_ms < max_ms,
                           f"{elapsed_ms:.0f}ms (max: {max_ms}ms)")
        except Exception as e:
            self.add_result('Response Time', False, str(e))

    def validate(self) -> bool:
        """Run all checks and return overall pass/fail"""
        self.check_http_health()
        self.check_database_connectivity()
        self.check_response_time()

        all_passed = all(c['passed'] for c in self.checks)
        # all() → True only if every element is truthy

        print(f"\n{'='*50}")
        print(f"DEPLOYMENT VALIDATION: {'PASSED ✅' if all_passed else 'FAILED ❌'}")
        print(f"{'='*50}")
        for check in self.checks:
            status = "✅" if check['passed'] else "❌"
            print(f"{status} {check['name']}: {check['details']}")

        return all_passed

# Usage
if __name__ == '__main__':
    validator = DeploymentValidator('https://api.company.com')
    success = validator.validate()
    exit(0 if success else 1)


