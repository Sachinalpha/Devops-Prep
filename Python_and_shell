import boto3

def upsert_dns_record(hosted_zone_id: str, name: str,
                      record_type: str, value: str, ttl: int = 300):
    """Create or update a DNS record in Route53"""
    route53 = boto3.client('route53')

    change_batch = {
        'Changes': [{
            'Action': 'UPSERT',  # UPSERT = create if not exists, update if exists
            'ResourceRecordSet': {
                'Name': name,
                'Type': record_type,   # A, CNAME, MX, TXT, etc.
                'TTL': ttl,
                'ResourceRecords': [{'Value': value}]
            }
        }]
    }

    response = route53.change_resource_record_sets(
        HostedZoneId=hosted_zone_id,
        ChangeBatch=change_batch
    )

    change_id = response['ChangeInfo']['Id']
    print(f"DNS change submitted: {change_id}")

    # Wait for the change to propagate
    waiter = route53.get_waiter('resource_record_sets_changed')
    # waiter → polls AWS until a condition is met (built into boto3)
    waiter.wait(Id=change_id)
    print("DNS change propagated successfully")

