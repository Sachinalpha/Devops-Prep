#!/bin/bash
# ssl_monitor.sh
# Purpose: Check SSL expiry for a list of domains and alert before expiration
# Critical for preventing production outages due to expired certificates

DOMAINS=("api.company.com" "www.company.com" "auth.company.com")
WARN_DAYS=30              # Warn if cert expires within 30 days
CRITICAL_DAYS=7           # Critical alert if less than 7 days

for DOMAIN in "${DOMAINS[@]}"; do
  # Get certificate expiry date using openssl
  EXPIRY=$(echo | openssl s_client -servername "$DOMAIN" \
    -connect "${DOMAIN}:443" 2>/dev/null \
    | openssl x509 -noout -enddate \
    | cut -d= -f2)
  # openssl s_client → establish TLS connection and print cert info
  # -servername → required for SNI (Server Name Indication) - needed when
  #               multiple certs on same IP
  # 2>/dev/null → discard stderr (openssl outputs lots of verbose info there)
  # openssl x509 -noout -enddate → parse cert and print only the expiry date
  # cut -d= -f2 → split by = and take the 2nd field (the actual date string)

  # Convert expiry to epoch seconds for math
  EXPIRY_EPOCH=$(date -d "$EXPIRY" +%s)
  NOW_EPOCH=$(date +%s)
  DAYS_LEFT=$(( (EXPIRY_EPOCH - NOW_EPOCH) / 86400 ))
  # 86400 = seconds per day
  # Integer arithmetic to find days remaining

  if [ "$DAYS_LEFT" -lt "$CRITICAL_DAYS" ]; then
    echo "CRITICAL: $DOMAIN cert expires in $DAYS_LEFT days! ($EXPIRY)"
    # In production: send PagerDuty alert here
  elif [ "$DAYS_LEFT" -lt "$WARN_DAYS" ]; then
    echo "WARNING: $DOMAIN cert expires in $DAYS_LEFT days ($EXPIRY)"
  else
    echo "OK: $DOMAIN cert valid for $DAYS_LEFT days ($EXPIRY)"
  fi
done


