#!/usr/bin/env python3
"""
db_migration.py
Purpose: Run database migrations safely with rollback support
"""

import pymysql          # pip install pymysql (or use psycopg2 for PostgreSQL)
import hashlib          # For computing checksums of migration files
import os
from pathlib import Path
from datetime import datetime

class MigrationRunner:
    """Handles database schema migrations"""

    def __init__(self, host, port, user, password, database):
        self.conn = pymysql.connect(
            host=host, port=port, user=user,
            password=password, database=database,
            cursorclass=pymysql.cursors.DictCursor
            # DictCursor → rows returned as dicts instead of tuples
        )
        self._create_migrations_table()

    def _create_migrations_table(self):
        """Create table to track which migrations have been run"""
        with self.conn.cursor() as cursor:
            # with cursor → auto-closes cursor when done
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS schema_migrations (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    filename VARCHAR(255) NOT NULL UNIQUE,
                    checksum VARCHAR(64) NOT NULL,
                    applied_at DATETIME NOT NULL,
                    execution_ms INT
                )
            """)
        self.conn.commit()
        # .commit() → save the transaction to the database

    def get_applied_migrations(self) -> set:
        """Return set of migration filenames that have already been applied"""
        with self.conn.cursor() as cursor:
            cursor.execute("SELECT filename FROM schema_migrations")
            rows = cursor.fetchall()
            # fetchall() → get all rows as a list of dicts
        return {row['filename'] for row in rows}
        # Set comprehension: {expression for item in iterable}
        # Using a set allows O(1) lookup vs O(n) for list

    def compute_checksum(self, content: str) -> str:
        """Hash migration file to detect corruption or tampering"""
        return hashlib.sha256(content.encode()).hexdigest()
        # .encode() → convert string to bytes (hashlib needs bytes)
        # .hexdigest() → return hash as hex string

    def run_migration(self, filepath: Path) -> bool:
        """Execute a single migration file"""
        content = filepath.read_text(encoding='utf-8')
        # Path.read_text() → read entire file as string

        checksum = self.compute_checksum(content)
        start = datetime.now()

        try:
            with self.conn.cursor() as cursor:
                # Split by semicolon to handle multi-statement migrations
                statements = [s.strip() for s in content.split(';') if s.strip()]
                # List comprehension with filter: [x for x in list if condition]

                for stmt in statements:
                    cursor.execute(stmt)

                # Record that this migration was applied
                cursor.execute("""
                    INSERT INTO schema_migrations
                    (filename, checksum, applied_at, execution_ms)
                    VALUES (%s, %s, %s, %s)
                """,
                (filepath.name, checksum, datetime.now(),
                 int((datetime.now() - start).total_seconds() * 1000))
                # %s → parameterized query (NEVER use f-strings for SQL — SQL injection!)
                )

            self.conn.commit()
            print(f"✅ Applied: {filepath.name}")
            return True

        except Exception as e:
            self.conn.rollback()
            # rollback() → undo all changes since last commit
            print(f"❌ Failed: {filepath.name}: {e}")
            return False

    def run_pending(self, migrations_dir: str) -> int:
        """Find and run all pending migrations in order"""
        applied = self.get_applied_migrations()
        migrations_path = Path(migrations_dir)

        # Get all .sql files, sorted by filename (001_create.sql, 002_alter.sql, etc.)
        pending = sorted(
            f for f in migrations_path.glob('*.sql')
            if f.name not in applied
            # Generator expression as filter: only unapplied migrations
        )

        if not pending:
            print("No pending migrations")
            return 0

        print(f"Found {len(pending)} pending migration(s)")
        success_count = 0
        for migration_file in pending:
            if self.run_migration(migration_file):
                success_count += 1
            else:
                print("Stopping due to migration failure")
                break  # Don't continue after a failure

        return success_count

    def close(self):
        self.conn.close()


