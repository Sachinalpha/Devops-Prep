#!/usr/bin/env python3
"""
k8s_monitor.py
Purpose: Monitor Kubernetes cluster resources using the official Python client
"""

from kubernetes import client, config  # pip install kubernetes
from kubernetes.client.rest import ApiException
import json
from datetime import datetime, timezone

def load_kube_config():
    """Load kubeconfig — works both in-cluster and from local ~/.kube/config"""
    try:
        config.load_incluster_config()
        # load_incluster_config → use ServiceAccount token mounted in pod
        # This is how scripts running INSIDE a K8s cluster authenticate
        print("Using in-cluster config")
    except config.ConfigException:
        config.load_kube_config()
        # Fallback to local ~/.kube/config for development
        print("Using local kubeconfig")

def get_pods_by_namespace(namespace: str = None) -> list:
    """List pods across all or specific namespace"""
    v1 = client.CoreV1Api()
    # CoreV1Api → access core Kubernetes objects (pods, services, configmaps)

    try:
        if namespace:
            pods = v1.list_namespaced_pod(namespace)
        else:
            pods = v1.list_pod_for_all_namespaces()
            # list_pod_for_all_namespaces → gets pods from every namespace

        result = []
        for pod in pods.items:
            # .items → list of pod objects in the response
            containers = []
            for container in pod.spec.containers:
                containers.append({
                    'name': container.name,
                    'image': container.image,
                    'resources': {
                        'requests': {
                            'cpu': container.resources.requests.get('cpu') if container.resources.requests else None,
                            'memory': container.resources.requests.get('memory') if container.resources.requests else None,
                        } if container.resources else {}
                    }
                })

            result.append({
                'name': pod.metadata.name,
                'namespace': pod.metadata.namespace,
                'status': pod.status.phase,
                # .phase → Pending/Running/Succeeded/Failed/Unknown
                'restarts': sum(
                    cs.restart_count
                    for cs in (pod.status.container_statuses or [])
                    # (x or []) → use empty list if x is None (avoids errors)
                ),
                'node': pod.spec.node_name,
                'containers': containers,
                'age': str(datetime.now(timezone.utc) - pod.metadata.creation_timestamp)
                if pod.metadata.creation_timestamp else 'unknown'
            })
        return result
    except ApiException as e:
        print(f"Kubernetes API error: {e.status} - {e.reason}")
        return []

def check_crashlooping_pods(namespace: str = None) -> list:
    """Find pods in CrashLoopBackOff — the bane of every DevOps engineer"""
    pods = get_pods_by_namespace(namespace)
    crash_pods = []

    for pod in pods:
        if pod['restarts'] > 3 or pod['status'] in ['Failed', 'Unknown']:
            crash_pods.append(pod)

    return crash_pods

def get_resource_quota_usage(namespace: str) -> dict:
    """Check how much of the namespace resource quota is being used"""
    v1 = client.CoreV1Api()
    try:
        quotas = v1.list_namespaced_resource_quota(namespace)
        result = {}
        for quota in quotas.items:
            name = quota.metadata.name
            result[name] = {
                'hard': dict(quota.spec.hard),   # Maximum allowed
                'used': dict(quota.status.used)   # Currently in use
            }
            # dict() → convert the Kubernetes object map to regular Python dict
        return result
    except ApiException as e:
        return {}

def scale_deployment(namespace: str, deployment: str, replicas: int) -> bool:
    """Scale a deployment to specified replicas"""
    apps_v1 = client.AppsV1Api()
    # AppsV1Api → access Deployments, StatefulSets, DaemonSets, ReplicaSets

    try:
        # Patch just the replicas field (partial update)
        body = {'spec': {'replicas': replicas}}
        apps_v1.patch_namespaced_deployment_scale(
            name=deployment,
            namespace=namespace,
            body=body
        )
        print(f"Scaled {deployment} to {replicas} replicas")
        return True
    except ApiException as e:
        print(f"Failed to scale: {e}")
        return False

if __name__ == '__main__':
    load_kube_config()

    print("=== CRASHLOOPING PODS ===")
    crash_pods = check_crashlooping_pods()
    for pod in crash_pods:
        print(f"  {pod['namespace']}/{pod['name']}: {pod['restarts']} restarts, status={pod['status']}")

    print("\n=== ALL PODS ===")
    all_pods = get_pods_by_namespace('production')
    print(json.dumps(all_pods, indent=2, default=str))


