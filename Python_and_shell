#!/bin/bash
# parallel_ssh.sh
# Purpose: Run a command on multiple servers simultaneously
# Used for mass updates, configuration changes, health checks across fleets

SERVERS_FILE="${1:-/etc/server_list.txt}"
# Read server list from file, default to /etc/server_list.txt
COMMAND="${2:-uptime}"
# Command to run, default to uptime
SSH_USER="deploy"
SSH_KEY="~/.ssh/deploy_key"
MAX_PARALLEL=10      # Run on 10 servers at a time
TIMEOUT=30           # SSH connection timeout in seconds

# ─── VALIDATE INPUT ───────────────────────────────────────────────────────────
if [ ! -f "$SERVERS_FILE" ]; then
  echo "ERROR: Server file not found: $SERVERS_FILE"
  echo "Usage: $0 <servers_file> <command>"
  exit 1
fi
# -f → true if file exists and is a regular file

RESULTS_DIR="/tmp/ssh_results_$(date +%s)"
# $(date +%s) → Unix timestamp (seconds since epoch) — great for unique temp dirs
mkdir -p "$RESULTS_DIR"

# ─── RUN COMMAND ON EACH SERVER IN PARALLEL ───────────────────────────────────
while IFS= read -r SERVER; do
  # IFS= → don't strip leading/trailing whitespace
  # read -r → raw mode: don't interpret backslashes
  [[ "$SERVER" =~ ^#|^$ ]] && continue
  # Skip comment lines (starting with #) and empty lines
  # =~ → regex match in [[ ]]

  # Run in background with & (parallel execution)
  (
    # Subshell () → runs in separate process
    RESULT=$(ssh -i "$SSH_KEY" \
      -o ConnectTimeout=$TIMEOUT \
      -o StrictHostKeyChecking=no \
      -o BatchMode=yes \
      "$SSH_USER@$SERVER" "$COMMAND" 2>&1)
    # -o ConnectTimeout → give up after N seconds
    # -o StrictHostKeyChecking=no → don't prompt for host key verification
    # -o BatchMode=yes → fail if password needed (we're using keys)
    # 2>&1 → merge stderr into stdout

    EXIT_CODE=$?
    # $? → exit code of the previous command (0=success, non-zero=failure)

    echo "=== $SERVER (exit: $EXIT_CODE) ===" > "$RESULTS_DIR/$SERVER"
    echo "$RESULT" >> "$RESULTS_DIR/$SERVER"
  ) &

  # ─── RATE LIMITING: LIMIT PARALLEL JOBS ──────────────────────────────────
  while [ $(jobs -r | wc -l) -ge $MAX_PARALLEL ]; do
    # jobs -r → list only running background jobs
    # wc -l   → count them
    sleep 0.5  # Wait before checking again
  done
done < "$SERVERS_FILE"

wait
# wait → block until ALL background jobs complete

# ─── DISPLAY RESULTS ──────────────────────────────────────────────────────────
echo "=== RESULTS ==="
for RESULT_FILE in "$RESULTS_DIR"/*; do
  cat "$RESULT_FILE"
  echo ""
done

rm -rf "$RESULTS_DIR"  # Cleanup temp files


