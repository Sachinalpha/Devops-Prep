#!/bin/bash
# bootstrap.sh
# Purpose: Configure a fresh server — install packages, create users, set configs
# Used in cloud-init, Ansible bootstrapping, or manual provisioning

set -euo pipefail

# ─── DETECT OS ────────────────────────────────────────────────────────────────
if [ -f /etc/os-release ]; then
  # Source the file to get OS variables
  . /etc/os-release
  # . (dot) = source command: runs file in current shell context
  OS=$ID          # ubuntu, debian, centos, rhel, etc.
  VERSION=$VERSION_ID
else
  echo "Cannot detect OS"
  exit 1
fi

echo "Setting up server: $(hostname) | OS: $OS $VERSION"

# ─── INSTALL PACKAGES ─────────────────────────────────────────────────────────
PACKAGES=("curl" "wget" "git" "vim" "htop" "jq" "unzip" "net-tools")

case "$OS" in
  ubuntu|debian)
    # case → pattern matching, like switch/case in other languages
    apt-get update -qq
    # -qq → quiet quiet: minimal output
    apt-get install -y "${PACKAGES[@]}"
    # -y → auto-answer yes to prompts
    ;;
    # ;; → end of this case branch
  centos|rhel|fedora)
    yum install -y "${PACKAGES[@]}"
    ;;
  *)
    # * → wildcard: matches anything not matched above (default case)
    echo "Unsupported OS: $OS"
    exit 1
    ;;
esac

# ─── CREATE DEPLOY USER ───────────────────────────────────────────────────────
DEPLOY_USER="deploy"
if ! id "$DEPLOY_USER" &>/dev/null; then
  # id user → prints user info, non-zero exit if user doesn't exist
  useradd -m -s /bin/bash -G sudo "$DEPLOY_USER"
  # useradd -m → create home directory
  # -s /bin/bash → set login shell
  # -G sudo → add to sudo group
  echo "Created user: $DEPLOY_USER"
fi

# ─── SET UP SSH KEY ───────────────────────────────────────────────────────────
SSH_DIR="/home/$DEPLOY_USER/.ssh"
mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"
# 700 → rwx------ (only owner can access this directory)

# Copy authorized keys from root (or fetch from your key server)
cp /root/.ssh/authorized_keys "$SSH_DIR/authorized_keys" 2>/dev/null || true
# || true → don't fail even if source doesn't exist (set -e would abort otherwise)
chmod 600 "$SSH_DIR/authorized_keys"
chown -R "$DEPLOY_USER:$DEPLOY_USER" "$SSH_DIR"
# -R → recursive: change ownership of all files inside too

# ─── CONFIGURE SSHD ───────────────────────────────────────────────────────────
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
# sed -i → edit file in-place
# s/old/new/ → substitute
# ^#\? → line starts with optional #
# .* → anything after the setting
# This disables root SSH login for security

sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
# Disable password auth — SSH keys only

systemctl restart sshd

echo "Bootstrap complete!"


