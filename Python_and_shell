import requests, time, json
from dataclasses import dataclass
from typing import List

@dataclass
class Alert:
    service: str
    severity: str    # critical, warning, info
    message: str
    timestamp: float = 0.0

class IncidentDetector:
    """Poll metrics and detect incidents automatically"""
    def __init__(self, prometheus_url: str):
        self.prom_url = prometheus_url
        self.active_alerts: List[Alert] = []

    def query(self, promql: str) -> list:
        """Execute a PromQL query against Prometheus"""
        response = requests.get(
            f"{self.prom_url}/api/v1/query",
            params={'query': promql}
            # params → adds ?query=... to URL automatically
        )
        response.raise_for_status()
        # raise_for_status() → raise exception if status code is 4xx or 5xx
        return response.json()['data']['result']

    def check_error_rate(self, service: str, threshold: float = 0.05) -> bool:
        """Check if error rate exceeds threshold (5% default)"""
        promql = f'rate(http_requests_total{{service="{service}",status=~"5.."}}[5m]) / rate(http_requests_total{{service="{service}"}}[5m])'
        # PromQL: rate of 5xx errors divided by total rate
        results = self.query(promql)
        if results:
            value = float(results[0]['value'][1])
            # value is [timestamp, value_string] — take index 1
            if value > threshold:
                self.active_alerts.append(Alert(service=service,
                    severity='critical', message=f"Error rate: {value:.1%}",
                    timestamp=time.time()))
                return True
        return False

