#!/bin/bash
# user_audit.sh
# Purpose: Audit user accounts - find users with sudo, no passwords, old logins
# Security compliance requirement in enterprise environments

REPORT="/tmp/user_audit_$(date +%Y%m%d).txt"
# Write to /tmp for temporary reports

exec > >(tee "$REPORT")
# exec > >(...)  → redirect all stdout for this script to the process substitution
# tee "$REPORT"  → write to both stdout and the report file
# This means everything printed from now on goes to both terminal and file

echo "=== USER AUDIT REPORT: $(date) ==="
echo "=== Host: $(hostname) ==="
echo ""

# ─── USERS WITH SUDO PRIVILEGES ───────────────────────────────────────────────
echo "--- SUDO USERS ---"
grep -Po '^sudo.+:\K.*$' /etc/group
# /etc/group stores group memberships
# grep -Po → print only matching part (-o) using Perl regex (-P)
# ^sudo.+:\K.*$ → match "sudo" group line, \K resets match start,
#                 .*$ captures the members after the colon

echo ""
echo "--- USERS WITH NO PASSWORD ---"
awk -F: '($2 == "" || $2 == "!") {print $1}' /etc/shadow
# /etc/shadow stores hashed passwords
# -F: → use colon as field delimiter
# $2 == ""  → no password set
# $2 == "!" → password locked/disabled
# print $1  → print the username (first field)

echo ""
echo "--- USERS WITH UID 0 (ROOT-LEVEL) ---"
awk -F: '($3 == 0) {print $1}' /etc/passwd
# /etc/passwd stores user account info
# $3 == 0 → UID is 0 (root-equivalent, should ONLY be root)
# This detects backdoor root accounts

echo ""
echo "--- ACCOUNTS NOT LOGGED IN FOR 90+ DAYS ---"
lastlog | awk 'NR>1 && $NF != "in" {print $0}' | while read LINE; do
  USER=$(echo "$LINE" | awk '{print $1}')
  LAST_LOGIN=$(echo "$LINE" | awk '{print $4, $5, $6, $7, $8, $9}')
  echo "User: $USER | Last Login: $LAST_LOGIN"
done
# lastlog → shows last login time for all users
# NR>1     → skip header line (NR = number of records/lines)
# $NF != "in" → $NF is last field; "in" appears in "Never logged in" lines

echo ""
echo "Audit report saved to: $REPORT"


