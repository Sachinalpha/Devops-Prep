import boto3, os
from google.cloud import storage as gcs  # pip install google-cloud-storage
from azure.storage.blob import BlobServiceClient  # pip install azure-storage-blob
from typing import Protocol  # Type-safe interfaces in Python

class CloudStorage(Protocol):
    """Protocol = interface definition (structural typing)"""
    def upload(self, local_path: str, remote_path: str) -> bool: ...
    def download(self, remote_path: str, local_path: str) -> bool: ...
    def list_files(self, prefix: str) -> list: ...

class S3Storage:
    def __init__(self, bucket: str, region: str = 'us-east-1'):
        self.s3 = boto3.client('s3', region_name=region)
        self.bucket = bucket

    def upload(self, local_path: str, remote_path: str) -> bool:
        try:
            self.s3.upload_file(local_path, self.bucket, remote_path)
            return True
        except Exception as e:
            print(f"S3 upload failed: {e}"); return False

    def list_files(self, prefix: str = '') -> list:
        paginator = self.s3.get_paginator('list_objects_v2')
        # paginator → auto-handle multi-page S3 responses (>1000 objects)
        pages = paginator.paginate(Bucket=self.bucket, Prefix=prefix)
        return [obj['Key'] for page in pages for obj in page.get('Contents', [])]
        # Nested list comprehension: flatten pages → objects → keys

class GCSStorage:
    def __init__(self, bucket: str):
        self.client = gcs.Client()
        self.bucket = self.client.bucket(bucket)

    def upload(self, local_path: str, remote_path: str) -> bool:
        try:
            blob = self.bucket.blob(remote_path)
            blob.upload_from_filename(local_path)
            return True
        except Exception as e:
            print(f"GCS upload failed: {e}"); return False

