    """Ship logs from files to Elasticsearch (ELK stack)"""
    def __init__(self, es_host='localhost', es_port=9200):
        self.es = Elasticsearch([{'host': es_host, 'port': es_port}])
        self.cursor_file = '/var/lib/logshipper/cursor.json'
        # cursor = position in log file we've read up to

    def get_cursor(self, filepath: str) -> int:
        """Remember where we left off in a log file"""
        try:
            cursors = json.loads(Path(self.cursor_file).read_text())
            return cursors.get(filepath, 0)  # 0 = start of file
        except (FileNotFoundError, json.JSONDecodeError):
            return 0

    def save_cursor(self, filepath: str, position: int):
        """Save current position so we don't re-ship old logs"""
        try:
            cursors = json.loads(Path(self.cursor_file).read_text())
        except:
            cursors = {}
        cursors[filepath] = position
        Path(self.cursor_file).parent.mkdir(parents=True, exist_ok=True)
        # exist_ok=True → don't fail if directory already exists
        Path(self.cursor_file).write_text(json.dumps(cursors))

    def ship_logs(self, filepath: str, index: str):
        position = self.get_cursor(filepath)
        with open(filepath, 'r') as f:
            f.seek(position)  # Jump to last known position
            for line in f:
                try:
                    doc = json.loads(line)   # Parse JSON log line
                    self.es.index(index=index, body=doc)
                    # .index() → write document to Elasticsearch
                except json.JSONDecodeError:
                    doc = {'message': line.strip(), 'timestamp': time.time()}
                    self.es.index(index=index, body=doc)
            self.save_cursor(filepath, f.tell())
            # f.tell() → current byte position in file

