#!/usr/bin/env python3
"""
api_healthcheck.py
Purpose: Check API endpoints health with retry, timeout, and alerting
"""

import requests              # HTTP library (pip install requests)
import time
import json
import logging
from typing import Dict, Optional
from dataclasses import dataclass, field  # Clean data classes
from urllib.parse import urlparse

@dataclass  # @dataclass → auto-generates __init__, __repr__, etc.
class HealthCheckResult:
    """Structured result from a single health check"""
    url: str
    status_code: Optional[int] = None
    response_time_ms: float = 0.0
    is_healthy: bool = False
    error: Optional[str] = None
    timestamp: str = field(default_factory=lambda: str(time.time()))
    # default_factory → call this function to get default value (not shared instance)

def check_endpoint(
    url: str,
    expected_status: int = 200,
    timeout: int = 10,
    max_retries: int = 3,
    retry_delay: int = 5,
    expected_body_contains: str = None
) -> HealthCheckResult:
    """
    Check a single endpoint with retry logic.
    Exponential backoff is the industry standard — built in here as linear for simplicity.
    """
    result = HealthCheckResult(url=url)

    for attempt in range(max_retries):
        # range(3) → 0, 1, 2 (3 attempts)
        try:
            start_time = time.perf_counter()
            # perf_counter() → high-resolution timer (better than time.time() for intervals)

            response = requests.get(
                url,
                timeout=timeout,
                # timeout → raise exception if server doesn't respond in N seconds
                headers={
                    'User-Agent': 'HealthChecker/1.0',
                    'Accept': 'application/json'
                },
                verify=True  # Verify SSL certificate (never set False in production!)
            )

            elapsed_ms = (time.perf_counter() - start_time) * 1000
            # * 1000 → convert seconds to milliseconds

            result.status_code = response.status_code
            result.response_time_ms = round(elapsed_ms, 2)

            # Validate response
            if response.status_code != expected_status:
                result.error = f"Expected {expected_status}, got {response.status_code}"
            elif expected_body_contains and expected_body_contains not in response.text:
                result.error = f"Response missing expected content: {expected_body_contains}"
            else:
                result.is_healthy = True
                break  # Success — exit retry loop

        except requests.exceptions.Timeout:
            result.error = f"Timeout after {timeout}s (attempt {attempt+1}/{max_retries})"
        except requests.exceptions.SSLError as e:
            result.error = f"SSL error: {e}"
            break  # Don't retry SSL errors
        except requests.exceptions.ConnectionError as e:
            result.error = f"Connection failed: {e}"
        except Exception as e:
            result.error = f"Unexpected error: {e}"

        if attempt < max_retries - 1:
            # Don't sleep after the last attempt
            time.sleep(retry_delay * (attempt + 1))
            # * (attempt + 1) → increasing delay: 5s, 10s, 15s (linear backoff)

    return result

def check_all_endpoints(endpoints: list) -> Dict[str, HealthCheckResult]:
    """Check multiple endpoints and return results dict"""
    results = {}
    for endpoint_config in endpoints:
        url = endpoint_config['url']
        print(f"Checking: {url}")
        results[url] = check_endpoint(**endpoint_config)
        # **dict → unpack dictionary as keyword arguments to function
    return results

# ─── USAGE ────────────────────────────────────────────────────────────────────
if __name__ == '__main__':
    ENDPOINTS = [
        {'url': 'https://api.company.com/health', 'expected_status': 200,
         'expected_body_contains': '"status":"ok"'},
        {'url': 'https://api.company.com/v2/status', 'timeout': 5},
        {'url': 'https://auth.company.com/ping', 'max_retries': 5},
    ]

    results = check_all_endpoints(ENDPOINTS)

    all_healthy = True
    for url, result in results.items():
        status = "✅ OK" if result.is_healthy else "❌ FAIL"
