#!/bin/bash
# deploy.sh
# Purpose: Pull latest code, build, test, restart service — zero-downtime deploy
# Widely used in CI/CD pipelines

set -euo pipefail
# set -e → exit immediately on any error (crucial for deployments!)
# set -u → treat unset variables as errors (prevents bugs)
# set -o pipefail → if any command in a pipe fails, the whole pipe fails

APP_DIR="/opt/myapp"
BACKUP_DIR="/opt/backups/$(date +%Y%m%d_%H%M%S)"
GIT_REPO="https://github.com/company/myapp.git"
BRANCH="${1:-main}"
# ${1:-main} → use first argument if provided, otherwise default to "main"
# This makes branch configurable: ./deploy.sh staging

# ─── LOGGING HELPER ───────────────────────────────────────────────────────────
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}
# This defines a function: log "message" → prints timestamped message
# $1 inside function refers to the first argument passed TO the function

# ─── TRAP FOR ROLLBACK ON FAILURE ─────────────────────────────────────────────
rollback() {
  log "DEPLOYMENT FAILED! Rolling back to previous version..."
  cp -r "$BACKUP_DIR/." "$APP_DIR/"
  # cp -r dir/. dest/ → copy all contents including hidden files
  systemctl restart myapp
  exit 1
}
trap rollback ERR
# trap → catch signals and errors
# ERR   → triggered whenever a command exits with non-zero status
# This automatically calls rollback() if anything fails

# ─── BACKUP CURRENT VERSION ───────────────────────────────────────────────────
log "Creating backup at $BACKUP_DIR"
mkdir -p "$BACKUP_DIR"
cp -r "$APP_DIR/." "$BACKUP_DIR/"

# ─── PULL LATEST CODE ─────────────────────────────────────────────────────────
log "Pulling latest code from branch: $BRANCH"
cd "$APP_DIR"
git fetch origin
git checkout "$BRANCH"
git pull origin "$BRANCH"

# ─── INSTALL DEPENDENCIES ─────────────────────────────────────────────────────
log "Installing dependencies..."
npm install --production
# --production → skip devDependencies (faster, smaller for production)

# ─── RUN TESTS ────────────────────────────────────────────────────────────────
log "Running tests..."
npm test
# If tests fail, set -e will trigger the trap → automatic rollback

# ─── GRACEFUL RESTART ─────────────────────────────────────────────────────────
log "Restarting application..."
systemctl reload-or-restart myapp
# reload-or-restart → try reload (graceful, zero downtime) first,
#                     restart only if reload isn't supported

log "Deployment successful! Branch: $BRANCH"


