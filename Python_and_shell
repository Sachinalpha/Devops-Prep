import yaml, subprocess, sys, json
from datetime import datetime

class RunbookExecutor:
    """Execute standardized runbooks — codified incident response"""

    def __init__(self, runbook_file: str):
        with open(runbook_file) as f:
            self.runbook = yaml.safe_load(f)
        # YAML runbook defines steps declaratively
        self.results = []

    def execute_step(self, step: dict) -> dict:
        """Execute a single runbook step"""
        name = step['name']
        command = step['command']
        on_failure = step.get('on_failure', 'abort')  # abort or continue

        print(f"Executing: {name}")
        print(f"Command: {command}")

        result = subprocess.run(command, shell=True,
                               capture_output=True, text=True, timeout=300)
        # shell=True → run through shell (allows pipes, redirects)
        # timeout=300 → fail if step takes more than 5 minutes

        step_result = {
            'name': name, 'command': command,
            'exit_code': result.returncode,
            'stdout': result.stdout[:1000],  # [:1000] → first 1000 chars
            'timestamp': str(datetime.now())
        }

        if result.returncode != 0:
            step_result['status'] = 'FAILED'
            if on_failure == 'abort':
                raise RuntimeError(f"Step failed: {name}\n{result.stderr}")
        else:
            step_result['status'] = 'SUCCESS'

        return step_result

    def run(self) -> bool:
        """Execute all runbook steps and generate audit log"""
        print(f"Starting runbook: {self.runbook['name']}")
        success = True
        for step in self.runbook.get('steps', []):
            try:
                result = self.execute_step(step)
                self.results.append(result)
            except RuntimeError as e:
                print(f"ABORT: {e}")
                success = False
                break
        self._save_audit_log()
        return success

    def _save_audit_log(self):
        log_file = f"/var/log/runbooks/{self.runbook['name']}_{int(datetime.now().timestamp())}.json"
        with open(log_file, 'w') as f:
            json.dump({'runbook': self.runbook['name'],
                       'results': self.results}, f, indent=2)

