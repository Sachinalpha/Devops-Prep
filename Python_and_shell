#!/usr/bin/env python3
"""
parallel_processor.py
Purpose: Process thousands of files in parallel using multiprocessing
Common in ETL pipelines, log processing, data transformation jobs
"""

from multiprocessing import Pool, cpu_count  # True parallelism (bypasses Python GIL)
from concurrent.futures import ThreadPoolExecutor, ProcessPoolExecutor, as_completed
from pathlib import Path
import time
import json
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def process_single_file(filepath: str) -> dict:
    """
    Worker function: process one file.
    Must be defined at module level for multiprocessing to pickle it.
    (pickle = Python's object serialization for cross-process communication)
    """
    path = Path(filepath)
    try:
        content = path.read_text(encoding='utf-8')
        # Simulate processing (replace with real logic: parse, transform, etc.)
        lines = content.splitlines()
        # .splitlines() → split on any line ending (\n, \r\n, \r)
        word_count = sum(len(line.split()) for line in lines)
        # sum() with generator → count total words across all lines

        return {
            'file': str(filepath),
            'size_bytes': path.stat().st_size,
            # .stat().st_size → file size in bytes
            'lines': len(lines),
            'words': word_count,
            'status': 'success'
        }
    except Exception as e:
        return {'file': str(filepath), 'status': 'error', 'error': str(e)}

def process_files_parallel(file_list: list, workers: int = None) -> list:
    """
    Process files using a process pool — true parallelism for CPU-bound tasks.
    ThreadPoolExecutor is better for I/O-bound tasks (network, disk).
    ProcessPoolExecutor is better for CPU-bound tasks (computation).
    """
    workers = workers or min(cpu_count(), len(file_list))
    # cpu_count() → number of CPU cores available
    # min() → don't use more workers than files

    results = []
    completed = 0

    logger.info(f"Processing {len(file_list)} files with {workers} workers")
    start = time.perf_counter()

    with ProcessPoolExecutor(max_workers=workers) as executor:
        # Submit all jobs to the pool (returns Future objects)
        future_to_file = {
            executor.submit(process_single_file, f): f
            for f in file_list
            # Dict comprehension: {key: value for item in iterable}
        }

        for future in as_completed(future_to_file):
            # as_completed → yield futures as they COMPLETE (not submission order)
            file = future_to_file[future]
            try:
                result = future.result()
                # .result() → get the return value, or re-raise any exception
                results.append(result)
            except Exception as e:
                logger.error(f"File {file} generated exception: {e}")
                results.append({'file': str(file), 'status': 'error', 'error': str(e)})

            completed += 1
            if completed % 100 == 0:
                # Report progress every 100 files
                logger.info(f"Progress: {completed}/{len(file_list)}")

    elapsed = time.perf_counter() - start
    logger.info(f"Processed {len(file_list)} files in {elapsed:.1f}s "
                f"({len(file_list)/elapsed:.0f} files/sec)")

    return results

if __name__ == '__main__':
    # Find all log files to process
    log_dir = Path('/var/log')
    files = [str(f) for f in log_dir.rglob('*.log') if f.is_file()]
    # .rglob('*.log') → recursive glob: find pattern in all subdirectories

    results = process_files_parallel(files)

    # Summarize results
    successful = [r for r in results if r['status'] == 'success']
    failed = [r for r in results if r['status'] == 'error']
    # List comprehension with filter

    print(f"Processed: {len(successful)} success, {len(failed)} failed")
    total_lines = sum(r.get('lines', 0) for r in successful)
    print(f"Total lines processed: {total_lines:,}")


