import boto3
from datetime import datetime, timedelta
from collections import defaultdict
import json

def get_cost_by_service(days: int = 30) -> dict:
    """Get AWS costs broken down by service for the last N days"""
    ce = boto3.client('ce', region_name='us-east-1')
    # ce = Cost Explorer client

    end_date = datetime.today().strftime('%Y-%m-%d')
    start_date = (datetime.today() - timedelta(days=days)).strftime('%Y-%m-%d')
    # timedelta → represent a duration of time, used for date arithmetic

    response = ce.get_cost_and_usage(
        TimePeriod={'Start': start_date, 'End': end_date},
        Granularity='MONTHLY',
        # DAILY, MONTHLY, or HOURLY
        Metrics=['BlendedCost'],
        # BlendedCost → average rate across all instance families
        GroupBy=[{'Type': 'DIMENSION', 'Key': 'SERVICE'}]
        # GROUP BY service (like SQL GROUP BY)
    )

    costs = {}
    for result in response['ResultsByTime']:
        for group in result['Groups']:
            service = group['Keys'][0]
            amount = float(group['Metrics']['BlendedCost']['Amount'])
            # Amount comes as string — convert to float for math
            costs[service] = costs.get(service, 0) + amount
            # .get(key, default) → add to existing or start from 0

    # Sort by cost descending
    return dict(sorted(costs.items(), key=lambda x: x[1], reverse=True))
    # sorted() with key=lambda → custom sort function
    # lambda x: x[1] → sort by value (cost amount)

def get_cost_by_tag(tag_key: str = 'Team', days: int = 30) -> dict:
    """Get costs broken down by a specific tag (e.g., Team, Environment)"""
    ce = boto3.client('ce', region_name='us-east-1')
    end_date = datetime.today().strftime('%Y-%m-%d')
    start_date = (datetime.today() - timedelta(days=days)).strftime('%Y-%m-%d')

    response = ce.get_cost_and_usage(
        TimePeriod={'Start': start_date, 'End': end_date},
        Granularity='MONTHLY',
        Metrics=['BlendedCost'],
        GroupBy=[{'Type': 'TAG', 'Key': tag_key}]
        # Group by tag value — shows which team/project is spending what
    )

    costs = {}
    for result in response['ResultsByTime']:
        for group in result['Groups']:
            tag_value = group['Keys'][0].replace(f'{tag_key}$', '')
            # AWS prepends "TagKey$" to values — strip it
            amount = float(group['Metrics']['BlendedCost']['Amount'])
            costs[tag_value or 'untagged'] = costs.get(tag_value or 'untagged', 0) + amount

    return dict(sorted(costs.items(), key=lambda x: x[1], reverse=True))

def generate_cost_report(days: int = 30) -> str:
    """Generate a cost breakdown report"""
    print(f"Fetching AWS costs for last {days} days...")

    service_costs = get_cost_by_service(days)
    team_costs = get_cost_by_tag('Team', days)

    total = sum(service_costs.values())

    report_lines = [
        f"AWS COST REPORT - Last {days} days",
        f"Generated: {datetime.now()}",
        f"Total Spend: ${total:,.2f}",
        # :,.2f → comma-separated thousands, 2 decimal places
        "",
        "=== By Service ===",
    ]

    for service, cost in service_costs.items():
        pct = cost / total * 100 if total > 0 else 0
        report_lines.append(f"  {service:<40} ${cost:>10,.2f} ({pct:.1f}%)")
        # :<40 → left-align in 40-char field
        # :>10 → right-align in 10-char field

    report_lines.extend(["", "=== By Team ==="])
    for team, cost in team_costs.items():
        report_lines.append(f"  {team:<30} ${cost:>10,.2f}")

    return "\n".join(report_lines)

if __name__ == '__main__':
    print(generate_cost_report(30))


