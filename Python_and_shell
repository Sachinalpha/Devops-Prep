from email.mime.text import MIMEText  # Build email messages

# Configure logging — every production script should have this
logging.basicConfig(
    level=logging.INFO,               # Log level: DEBUG < INFO < WARNING < ERROR < CRITICAL
    format='%(asctime)s %(levelname)s %(message)s',  # Log format
    handlers=[
        logging.FileHandler('/var/log/sysmonitor.log'),  # Write to file
        logging.StreamHandler()                           # Also print to terminal
    ]
)
logger = logging.getLogger(__name__)
# __name__ → module name; when run directly it's "__main__"

# Configuration as constants — easy to change without touching logic
CPU_THRESHOLD = 85      # Alert if CPU > 85%
MEM_THRESHOLD = 80      # Alert if memory > 80%
DISK_THRESHOLD = 90     # Alert if disk > 90%
CHECK_INTERVAL = 60     # Check every 60 seconds

def get_system_stats() -> dict:
    """
    Collect current system resource statistics.
    Returns dict with CPU, memory, disk, and network metrics.
    -> dict is a type hint: tells developers what the function returns
    """
    stats = {}

    # CPU usage (percent, averaged over 1 second interval)
    stats['cpu_percent'] = psutil.cpu_percent(interval=1)
    # interval=1 → measure average CPU over 1 second (more accurate than 0)

    # Memory statistics
    mem = psutil.virtual_memory()
    # .virtual_memory() returns named tuple with: total, available, used, percent, etc.
    stats['mem_percent'] = mem.percent
    stats['mem_used_gb'] = round(mem.used / (1024**3), 2)
    # 1024**3 = 1 GB in bytes; ** is exponentiation in Python
    # round(n, 2) → round to 2 decimal places

    # Disk statistics for each partition
    stats['disks'] = {}
    for partition in psutil.disk_partitions():
        # .disk_partitions() → list of all mounted partitions
        try:
            usage = psutil.disk_usage(partition.mountpoint)
            stats['disks'][partition.mountpoint] = {
                'percent': usage.percent,
                'free_gb': round(usage.free / (1024**3), 2)
            }
        except PermissionError:
            # Some partitions (like /proc) raise PermissionError
            continue  # Skip inaccessible partitions

    # Network I/O statistics
    net = psutil.net_io_counters()
    stats['net_bytes_sent'] = net.bytes_sent
    stats['net_bytes_recv'] = net.bytes_recv

    return stats

def send_alert(subject: str, body: str, smtp_host: str = 'localhost') -> None:
    """Send email alert — production scripts need reliable alerting"""
    try:
        msg = MIMEText(body)
        msg['Subject'] = subject
        msg['From'] = 'monitoring@company.com'
        msg['To'] = 'oncall@company.com'

        with smtplib.SMTP(smtp_host) as server:
            # with statement → context manager: auto-closes connection when done
            server.sendmail(msg['From'], [msg['To']], msg.as_string())
        logger.info(f"Alert sent: {subject}")
        # f-string → f"..." lets you embed {variables} directly in strings
    except Exception as e:
        logger.error(f"Failed to send alert: {e}")
        # Exception e → capture the error object for logging

def check_thresholds(stats: dict) -> list:
    """Check if any metric exceeds thresholds. Returns list of alerts."""
    alerts = []

    if stats['cpu_percent'] > CPU_THRESHOLD:
        alerts.append(f"CPU HIGH: {stats['cpu_percent']}%")

    if stats['mem_percent'] > MEM_THRESHOLD:
        alerts.append(f"MEMORY HIGH: {stats['mem_percent']}%")

    for mount, disk_stats in stats['disks'].items():
        # .items() → iterate over key-value pairs in a dictionary
        if disk_stats['percent'] > DISK_THRESHOLD:
            alerts.append(f"DISK HIGH on {mount}: {disk_stats['percent']}%")

    return alerts

def main():
    """Main monitoring loop — runs indefinitely"""
    logger.info("System monitor started")

    while True:  # Infinite loop — monitor runs forever
        try:
            stats = get_system_stats()
            alerts = check_thresholds(stats)

            if alerts:
                alert_msg = "\n".join(alerts)  # Join list items with newlines
                logger.warning(f"ALERTS:\n{alert_msg}")
                send_alert("System Alert!", alert_msg)
            else:
                logger.info(f"OK - CPU:{stats['cpu_percent']}% MEM:{stats['mem_percent']}%")

            time.sleep(CHECK_INTERVAL)

        except KeyboardInterrupt:
            # Ctrl+C sends SIGINT → Python raises KeyboardInterrupt
            logger.info("Monitor stopped by user")
            break  # Exit the while loop

        except Exception as e:
            logger.error(f"Monitor error: {e}", exc_info=True)
            # exc_info=True → include full stack trace in log
            time.sleep(10)  # Brief pause before retrying

if __name__ == '__main__':
    # Only run main() when script is executed directly,
    # not when imported as a module by another script
    main()


