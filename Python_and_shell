#!/bin/bash
# db_backup.sh
# Purpose: Backup all databases, compress, upload to S3, cleanup old backups
# This is a standard pattern at every company using RDS or self-managed DBs

set -euo pipefail

DB_HOST="localhost"
DB_USER="backup_user"
DB_PASS="$(cat /run/secrets/db_password)"
# /run/secrets/ → Docker secrets or vault-mounted secrets path
# Never hardcode passwords! Always read from secure locations

BACKUP_DIR="/opt/db_backups"
S3_BUCKET="s3://company-db-backups"
DATE=$(date +%Y%m%d_%H%M%S)
RETENTION_DAYS=7

mkdir -p "$BACKUP_DIR"

# ─── GET LIST OF ALL DATABASES ────────────────────────────────────────────────
DATABASES=$(mysql -h"$DB_HOST" -u"$DB_USER" -p"$DB_PASS" \
  -e "SHOW DATABASES;" | grep -vE "^(Database|information_schema|performance_schema|mysql|sys)$")
# mysql -e "..." → execute SQL query and exit
# grep -vE       → exclude system/metadata databases

# ─── BACKUP EACH DATABASE ─────────────────────────────────────────────────────
for DB in $DATABASES; do
  BACKUP_FILE="$BACKUP_DIR/${DB}_${DATE}.sql.gz"

  echo "Backing up database: $DB"
  mysqldump -h"$DB_HOST" -u"$DB_USER" -p"$DB_PASS" \
    --single-transaction \
    --routines \
    --triggers \
    "$DB" | gzip > "$BACKUP_FILE"
  # mysqldump → creates SQL dump of the database
  # --single-transaction → consistent backup without locking tables (for InnoDB)
  # --routines → include stored procedures
  # --triggers → include triggers
  # | gzip > file → pipe directly to gzip (no temp file needed)

  echo "Uploading to S3..."
  aws s3 cp "$BACKUP_FILE" "$S3_BUCKET/$(basename $BACKUP_FILE)"
  # aws s3 cp → AWS CLI: copy local file to S3
  # basename  → strip directory path, keep just filename
done

# ─── CLEANUP OLD LOCAL BACKUPS ────────────────────────────────────────────────
find "$BACKUP_DIR" -name "*.sql.gz" -mtime +$RETENTION_DAYS -delete
echo "Backup complete. Old backups (>${RETENTION_DAYS} days) cleaned up."

# ─── CLEANUP OLD S3 BACKUPS ───────────────────────────────────────────────────
CUTOFF_DATE=$(date -d "-${RETENTION_DAYS} days" +%Y-%m-%d)
# date -d "-7 days" → date 7 days in the past
aws s3 ls "$S3_BUCKET/" | awk '{print $4}' | while read FILE; do
  FILE_DATE=$(echo "$FILE" | grep -oP '\d{8}')
  # grep -oP → only print matching part (-o), use Perl regex (-P)
  # \d{8} → 8 consecutive digits (matches our YYYYMMDD date format)
  if [[ "$FILE_DATE" < "$(date -d $CUTOFF_DATE +%Y%m%d)" ]]; then
    aws s3 rm "$S3_BUCKET/$FILE"
  fi
done


