#!/usr/bin/env python3
"""
log_analyzer.py
Purpose: Parse logs, detect anomalies, generate reports
FAANG companies process billions of log lines — this is core DevOps work
"""

import re                   # Regular expressions
import json
import gzip                 # Read gzip compressed files
from collections import Counter, defaultdict  # Specialized containers
from datetime import datetime, timedelta
from pathlib import Path    # Object-oriented file path handling
from typing import Generator, Dict, List

# Regex pattern for Nginx access logs
# Named groups (?P<name>...) make extraction readable
NGINX_LOG_PATTERN = re.compile(
    r'(?P<ip>\d+\.\d+\.\d+\.\d+) '     # IP address
    r'- - '                              # ident and auth (usually -)
    r'\[(?P<time>[^\]]+)\] '             # timestamp in brackets
    r'"(?P<method>\w+) (?P<url>[^ ]+) [^"]+" '  # Request line
    r'(?P<status>\d{3}) '               # Status code
    r'(?P<bytes>\d+)'                    # Response bytes
)

def read_log_file(filepath: str) -> Generator[str, None, None]:
    """
    Generator function to read logs — memory efficient for huge files.
    A generator yields values one at a time instead of loading all into memory.
    For a 100GB log file, this is the only sane approach.
    """
    path = Path(filepath)

    if path.suffix == '.gz':
        # Handle compressed log files
        with gzip.open(filepath, 'rt', encoding='utf-8') as f:
            # 'rt' → read mode, text (vs 'rb' for binary)
            yield from f  # yield from → yield each line from the file iterator
    else:
        with open(filepath, 'r', encoding='utf-8') as f:
            yield from f

def parse_log_line(line: str) -> dict:
    """Parse a single nginx log line into structured data"""
    match = NGINX_LOG_PATTERN.match(line.strip())
    if not match:
        return {}  # Return empty dict for lines that don't match

    data = match.groupdict()
    # .groupdict() → returns dict of all named capture groups

    # Convert types from string to appropriate Python types
    data['status'] = int(data['status'])
    data['bytes'] = int(data['bytes'])
    data['time'] = datetime.strptime(data['time'], '%d/%b/%Y:%H:%M:%S %z')
    # strptime → parse string to datetime using format codes
    # %d=day, %b=month name, %Y=year, %H=hour, %M=min, %S=sec, %z=timezone

    return data

def analyze_logs(filepath: str) -> Dict:
    """
    Analyze log file and return statistics dict.
    Uses Counter and defaultdict for efficient counting.
    """
    stats = {
        'total_requests': 0,
        'status_codes': Counter(),   # Counter auto-initializes counts to 0
        'top_ips': Counter(),
        'top_urls': Counter(),
        'errors_5xx': [],
        'requests_per_hour': defaultdict(int),  # default value = 0 for new keys
        'bytes_by_url': defaultdict(int),
    }

    for line in read_log_file(filepath):
        entry = parse_log_line(line)
        if not entry:
            continue  # Skip unparseable lines

        stats['total_requests'] += 1
        stats['status_codes'][entry['status']] += 1
        stats['top_ips'][entry['ip']] += 1
        stats['top_urls'][entry['url']] += 1

        # Group by hour for traffic pattern analysis
        hour_key = entry['time'].strftime('%Y-%m-%d %H:00')
        stats['requests_per_hour'][hour_key] += 1
        stats['bytes_by_url'][entry['url']] += entry['bytes']

        # Collect 5xx errors for deeper investigation
        if entry['status'] >= 500:
            stats['errors_5xx'].append({
                'time': str(entry['time']),
                'url': entry['url'],
                'status': entry['status'],
                'ip': entry['ip']
            })

    return stats

def detect_anomalies(stats: Dict) -> List[str]:
    """
    Simple anomaly detection:
    - High error rate
    - Unusual traffic spikes
    - Single IP making too many requests (potential DDoS/scraping)
    """
    anomalies = []

    # Check error rate
    total = stats['total_requests']
    if total == 0:
        return anomalies

    error_5xx = sum(count for code, count in stats['status_codes'].items() if code >= 500)
    # Generator expression in sum(): sums values matching condition
    error_rate = error_5xx / total * 100

    if error_rate > 5:  # More than 5% errors is concerning
        anomalies.append(f"HIGH ERROR RATE: {error_rate:.1f}% of requests are 5xx")
        # :.1f → format float with 1 decimal place

    # Check for IPs making excessive requests (rate limit detection)
    if stats['top_ips']:
        top_ip, top_count = stats['top_ips'].most_common(1)[0]
        # .most_common(n) → return n most common elements as [(item, count), ...]
        ip_ratio = top_count / total * 100
        if ip_ratio > 20:
            anomalies.append(
                f"SUSPICIOUS IP: {top_ip} made {top_count} requests ({ip_ratio:.1f}% of traffic)"
            )

    # Traffic spike detection — compare hours to mean
    if stats['requests_per_hour']:
        counts = list(stats['requests_per_hour'].values())
        mean = sum(counts) / len(counts)
        for hour, count in stats['requests_per_hour'].items():
            if count > mean * 3:  # More than 3x the average
                anomalies.append(f"TRAFFIC SPIKE at {hour}: {count} requests (mean: {mean:.0f})")

    return anomalies

def generate_report(stats: Dict, anomalies: List[str]) -> str:
    """Format analysis results as a readable report"""
    report = []
    report.append("=" * 60)
    report.append(f"LOG ANALYSIS REPORT - {datetime.now()}")
    report.append("=" * 60)
    report.append(f"\nTotal Requests: {stats['total_requests']:,}")
    # :, → format number with thousands separator (1000000 → 1,000,000)

    report.append("\n--- Status Code Distribution ---")
    for code, count in sorted(stats['status_codes'].items()):
        # sorted() → returns sorted list (by status code here)
        pct = count / stats['total_requests'] * 100
        report.append(f"  {code}: {count:,} ({pct:.1f}%)")

    report.append("\n--- Top 10 IPs ---")
    for ip, count in stats['top_ips'].most_common(10):
        report.append(f"  {ip}: {count:,} requests")

    report.append("\n--- Top 10 URLs ---")
    for url, count in stats['top_urls'].most_common(10):
        report.append(f"  {url}: {count:,} requests")

    if anomalies:
        report.append("\n--- ANOMALIES DETECTED ---")
        for anomaly in anomalies:
            report.append(f"  ⚠️  {anomaly}")

    return "\n".join(report)
    # "\n".join(list) → concatenate list items with newline separator


