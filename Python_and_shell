import json, subprocess, sys

def get_terraform_plan(working_dir: str) -> dict:
    """Parse Terraform plan output into structured data"""
    subprocess.run(['terraform', 'plan', '-out=tfplan'],
                  cwd=working_dir, check=True)
    # cwd=working_dir → set working directory for the subprocess

    result = subprocess.run(
        ['terraform', 'show', '-json', 'tfplan'],
        cwd=working_dir, capture_output=True, text=True, check=True
    )
    return json.loads(result.stdout)

def summarize_plan(plan: dict) -> dict:
    """Summarize what Terraform will do"""
    changes = plan.get('resource_changes', [])
    # .get() returns [] if key absent — avoids KeyError

    summary = {'create': [], 'update': [], 'delete': [], 'no-op': []}
    for resource in changes:
        actions = resource['change']['actions']
        # actions is a list like ['create'], ['update'], ['delete'], ['no-op']
        resource_info = {
            'type': resource['type'],
            'name': resource['name'],
            'address': resource['address']
        }
        if 'delete' in actions:
            summary['delete'].append(resource_info)  # Flag deletes as dangerous
        elif 'create' in actions:
            summary['create'].append(resource_info)
        elif 'update' in actions:
            summary['update'].append(resource_info)

    return summary

