#!/bin/bash
# log_cleanup.sh
# Purpose: Archive old logs and delete logs older than retention period
# Run via cron: 0 1 * * * /opt/scripts/log_cleanup.sh

LOG_DIR="/var/log/myapp"    # Directory containing application logs
ARCHIVE_DIR="/mnt/archives/logs"  # Where to store archived logs
RETENTION_DAYS=30           # Delete files older than this many days
MAX_SIZE_MB=100             # Archive logs larger than this size

# ─── CREATE ARCHIVE DIRECTORY ─────────────────────────────────────────────────
mkdir -p "$ARCHIVE_DIR"
# mkdir -p → create directory and all parent directories if they don't exist

# ─── GET TODAY'S DATE FOR NAMING ──────────────────────────────────────────────
ARCHIVE_NAME="logs_$(date +%Y%m%d).tar.gz"
# $(date +%Y%m%d) → formats date as "20240115" (no separators)

# ─── COMPRESS LOGS OLDER THAN 7 DAYS ─────────────────────────────────────────
find "$LOG_DIR" -name "*.log" -mtime +7 -exec gzip {} \;
# find ... -name "*.log" → find all .log files
# -mtime +7              → modified more than 7 days ago
# -exec gzip {} \;       → run gzip on each found file
#                          {} = placeholder for the current file
#                          \; = end the -exec command

# ─── ARCHIVE LARGE LOG FILES ──────────────────────────────────────────────────
find "$LOG_DIR" -name "*.log" -size +${MAX_SIZE_MB}M | while read LOGFILE; do
  # -size +100M → files larger than 100 megabytes
  BASENAME=$(basename "$LOGFILE" .log)
  # basename → strips the directory path and optional suffix from filename
  mv "$LOGFILE" "$ARCHIVE_DIR/${BASENAME}_$(date +%Y%m%d).log"
  # Move to archive with date stamp in the filename
  touch "$LOGFILE"
  # Recreate the empty log file so the application doesn't crash looking for it
done

# ─── DELETE OLD ARCHIVED FILES ────────────────────────────────────────────────
find "$ARCHIVE_DIR" -mtime +${RETENTION_DAYS} -type f -delete
# -type f  → only match files (not directories)
# -delete  → delete found files (more efficient than -exec rm)

# ─── REPORT ───────────────────────────────────────────────────────────────────
DELETED=$(find "$ARCHIVE_DIR" -mtime +${RETENTION_DAYS} | wc -l)
echo "[$(date)] Log cleanup complete. Archived logs in $ARCHIVE_DIR"
df -h "$ARCHIVE_DIR"  # Show disk usage of archive directory


