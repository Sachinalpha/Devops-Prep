#!/bin/bash
# docker_cleanup.sh
# Purpose: Clean up stopped containers, dangling images, old volumes
# Prevents disk space issues on Docker hosts in production

echo "=== Docker Cleanup Started: $(date) ==="

# ─── SHOW DISK USAGE BEFORE ───────────────────────────────────────────────────
echo "--- Before cleanup ---"
docker system df
# docker system df → shows disk space used by Docker (containers, images, volumes)

# ─── REMOVE STOPPED CONTAINERS ────────────────────────────────────────────────
echo "Removing stopped containers..."
STOPPED=$(docker ps -aq --filter "status=exited")
# docker ps -a      → list all containers (running + stopped)
# -q                → quiet mode: only print container IDs
# --filter status=exited → only stopped containers

if [ -n "$STOPPED" ]; then
  # -n → true if string is non-empty (i.e., there are stopped containers)
  docker rm $STOPPED
fi

# ─── REMOVE DANGLING IMAGES ───────────────────────────────────────────────────
echo "Removing dangling images..."
DANGLING=$(docker images -q --filter "dangling=true")
# -q → only print image IDs
# dangling=true → images not tagged and not referenced by any container
# These accumulate during builds and waste disk space

if [ -n "$DANGLING" ]; then
  docker rmi $DANGLING
fi

# ─── REMOVE OLD IMAGES (OLDER THAN 30 DAYS) ──────────────────────────────────
echo "Removing images older than 30 days..."
docker image prune -a --force --filter "until=720h"
# prune -a       → remove ALL unused images (not just dangling)
# --force        → don't ask for confirmation
# --filter until=720h → only remove images older than 720 hours (30 days)

# ─── CLEAN UNUSED VOLUMES ─────────────────────────────────────────────────────
echo "Removing unused volumes..."
docker volume prune --force
# Unused volumes = not mounted to any container
# WARNING: Be careful with this in production — verify first!

# ─── CLEAN BUILD CACHE ────────────────────────────────────────────────────────
docker builder prune --force --filter "until=168h"
# Build cache older than 168 hours (7 days)

echo "--- After cleanup ---"
docker system df
echo "=== Cleanup Complete ==="


